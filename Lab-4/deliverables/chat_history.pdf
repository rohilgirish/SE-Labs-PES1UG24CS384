/F1 8.5 Tf 40 810 Td (Lab 4: VibeCoding - Prompt Trajectory Log) Tj 340 0 Td (Page 3 of 4) Tj
ET BT 40 780 Td 13.5 TL
/F1 9 Tf (    columns safely.) '
/F1 9 Tf () '
/F2 9.5 Tf (LLM Response / Implemented Code \(ai.py\):) ' /F1 9 Tf
/F3 8.5 Tf (import copy) ' /F1 9 Tf
/F3 8.5 Tf (import random) ' /F1 9 Tf
/F3 8.5 Tf (COLS = 7) ' /F1 9 Tf
/F3 8.5 Tf () ' /F1 9 Tf
/F3 8.5 Tf (class AI:) ' /F1 9 Tf
/F3 8.5 Tf (    def choose_column\(self, board, me='O', opponent='X'\):) ' /F1 9 Tf
/F3 8.5 Tf (        legal = [c for c in range\(COLS\) if board.grid[0][c] == '.']) ' /F1 9 Tf
/F3 8.5 Tf (        if not legal: return None) ' /F1 9 Tf
/F3 8.5 Tf (        # 1. Take an immediate win.) ' /F1 9 Tf
/F3 8.5 Tf (        for col in legal:) ' /F1 9 Tf
/F3 8.5 Tf (            if self._wins_if_played\(board, col, me\):) ' /F1 9 Tf
/F3 8.5 Tf (                return col) ' /F1 9 Tf
/F3 8.5 Tf (        # 2. Block the opponent's immediate win.) ' /F1 9 Tf
/F3 8.5 Tf (        for col in legal:) ' /F1 9 Tf
/F3 8.5 Tf (            if self._wins_if_played\(board, col, opponent\):) ' /F1 9 Tf
/F3 8.5 Tf (                return col) ' /F1 9 Tf
/F3 8.5 Tf (        # 3. Choose safely: avoid moves handing opponent a win above & prefer center.) ' /F1 9 Tf
/F3 8.5 Tf (        safe = [c for c in legal if not self._gives_win_above\(board, c, me, opponent\)]) ' /F1 9 Tf
/F3 8.5 Tf (        candidates = safe or legal) ' /F1 9 Tf
/F3 8.5 Tf (        center = COLS // 2) ' /F1 9 Tf
/F3 8.5 Tf (        best = min\(abs\(c - center\) for c in candidates\)) ' /F1 9 Tf
/F3 8.5 Tf (        return random.choice\([c for c in candidates if abs\(c - center\) == best]\)) ' /F1 9 Tf
/F3 8.5 Tf () ' /F1 9 Tf
/F3 8.5 Tf (    @staticmethod) ' /F1 9 Tf
/F3 8.5 Tf (    def _wins_if_played\(board, col, token\):) ' /F1 9 Tf
/F3 8.5 Tf (        trial = copy.deepcopy\(board\)) ' /F1 9 Tf
/F3 8.5 Tf (        if trial.drop\(col, token\) is None: return False) ' /F1 9 Tf
/F3 8.5 Tf (        return trial.winner\(token\)) ' /F1 9 Tf
/F3 8.5 Tf () ' /F1 9 Tf
/F3 8.5 Tf (    @staticmethod) ' /F1 9 Tf
/F3 8.5 Tf (    def _gives_win_above\(board, col, me, opponent\):) ' /F1 9 Tf
/F3 8.5 Tf (        trial = copy.deepcopy\(board\)) ' /F1 9 Tf
/F3 8.5 Tf (        if trial.drop\(col, me\) is None: return False) ' /F1 9 Tf
/F3 8.5 Tf (        if trial.grid[0][col] != '.': return False) ' /F1 9 Tf
/F3 8.5 Tf (        return trial.drop\(col, opponent\) is not None and trial.winner\(opponent\)) ' /F1 9 Tf
/F1 9 Tf () '
/F1 8 Tf (==================================================================) '
/F2 10.5 Tf (PROMPT 4 \(Task 4: Move-Level Feedback\)) ' /F1 9 Tf
/F1 8 Tf (==================================================================) '
/F2 9.5 Tf (User Prompt:) ' /F1 9 Tf
/F1 9 Tf (    In game.py, add concise move-level feedback that prints which column the player or AI) '
ET
endstream
endobj
