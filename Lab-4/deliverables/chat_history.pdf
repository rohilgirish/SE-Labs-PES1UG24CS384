/F3 8.5 Tf (        self.ai = AI\(\)) ' /F1 9 Tf
/F3 8.5 Tf (        self.turn = "X") ' /F1 9 Tf
/F3 8.5 Tf (    def run\(self\):) ' /F1 9 Tf
/F3 8.5 Tf (        print\("Connect Four -- you are X."\)) ' /F1 9 Tf
/F3 8.5 Tf (        while True:) ' /F1 9 Tf
/F3 8.5 Tf (            self.board.print\(\)) ' /F1 9 Tf
/F3 8.5 Tf (            if self.turn == "X":) ' /F1 9 Tf
/F3 8.5 Tf (                try:) ' /F1 9 Tf
/F3 8.5 Tf (                    raw = input\("Column \(1-7\), or q: "\).strip\(\).lower\(\)) ' /F1 9 Tf
/F3 8.5 Tf (                except \(EOFError, KeyboardInterrupt\):) ' /F1 9 Tf
/F3 8.5 Tf (                    print\("\\nGoodbye."\)) ' /F1 9 Tf
/F3 8.5 Tf (                    return) ' /F1 9 Tf
/F3 8.5 Tf (                if raw == "q":) ' /F1 9 Tf
/F3 8.5 Tf (                    print\("Game quit."\)) ' /F1 9 Tf
/F3 8.5 Tf (                    return) ' /F1 9 Tf
/F3 8.5 Tf (                try:) ' /F1 9 Tf
/F3 8.5 Tf (                    col = int\(raw\) - 1) ' /F1 9 Tf
/F3 8.5 Tf (                except ValueError:) ' /F1 9 Tf
/F3 8.5 Tf (                    print\("Please enter a number from 1 to 7, or q to quit."\)) ' /F1 9 Tf
/F3 8.5 Tf (                    continue) ' /F1 9 Tf
/F3 8.5 Tf (                if not 0 <= col < COLS:) ' /F1 9 Tf
/F3 8.5 Tf (                    print\("Column must be between 1 and 7."\)) ' /F1 9 Tf
/F3 8.5 Tf (                    continue) ' /F1 9 Tf
/F3 8.5 Tf (            else:) ' /F1 9 Tf
/F3 8.5 Tf (                col = self.ai.choose_column\(self.board\)) ' /F1 9 Tf
/F3 8.5 Tf (                if col is None or not 0 <= col < COLS:) ' /F1 9 Tf
/F3 8.5 Tf (                    print\("AI returned an invalid column; ending game."\)) ' /F1 9 Tf
/F3 8.5 Tf (                    return) ' /F1 9 Tf
/F3 8.5 Tf (            if self.board.drop\(col, self.turn\) is None:) ' /F1 9 Tf
/F3 8.5 Tf (                if self.turn == "X":) ' /F1 9 Tf
/F3 8.5 Tf (                    print\(f"Column {col + 1} is full. Choose another."\)) ' /F1 9 Tf
/F3 8.5 Tf (                    continue) ' /F1 9 Tf
/F3 8.5 Tf (                print\("AI chose a full column; ending game."\)) ' /F1 9 Tf
/F3 8.5 Tf (                return) ' /F1 9 Tf
/F3 8.5 Tf (            if self.board.winner\(self.turn\):) ' /F1 9 Tf
/F3 8.5 Tf (                self.board.print\(\)) ' /F1 9 Tf
/F3 8.5 Tf (                print\(self.turn, "wins!"\)) ' /F1 9 Tf
/F3 8.5 Tf (                return) ' /F1 9 Tf
/F3 8.5 Tf (            if self.board.full\(\):) ' /F1 9 Tf
/F3 8.5 Tf (                self.board.print\(\)) ' /F1 9 Tf
/F3 8.5 Tf (                print\("Draw."\)) ' /F1 9 Tf
/F3 8.5 Tf (                return) ' /F1 9 Tf
/F3 8.5 Tf (            self.turn = "O" if self.turn == "X" else "X") ' /F1 9 Tf
/F1 9 Tf () '
