/F3 8.5 Tf (from ai import AI) ' /F1 9 Tf
/F3 8.5 Tf (class Game:) ' /F1 9 Tf
/F3 8.5 Tf (    def __init__\(self\):) ' /F1 9 Tf
/F3 8.5 Tf (        self.board = Board\(\)) ' /F1 9 Tf
ET
endstream
